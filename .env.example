# 复制为 .env 后按需修改；.env 已被 .gitignore 忽略。
DB_URL=jdbc:mysql://localhost:3307/voucherx?useUnicode=true&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
DB_NAME=voucherx
DB_USERNAME=voucherx
DB_PASSWORD=voucherx
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5673
RABBITMQ_USERNAME=voucherx
RABBITMQ_PASSWORD=voucherx
# 仅本地开发可设为 true；生产必须为 false。
AUTH_EXPOSE_CODE=true

# 03–06 交付开关；批量、模拟支付、自动修复和故障注入默认关闭。
DELIVERY_ENABLED=true
DELIVERY_BATCH_ENABLED=false
PAYMENT_SIMULATION_ENABLED=false
RECONCILE_ENABLED=false
FAULT_INJECTION_ENABLED=false
